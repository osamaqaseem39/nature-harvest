# ========================================
# Nature Harvest Dashboard Environment Configuration
# ========================================

# ========================================
# API Configuration
# ========================================
REACT_APP_API_URL=https://nature-harvest-q2ra.vercel.app/api
REACT_APP_API_TIMEOUT=10000
REACT_APP_API_RETRY_ATTEMPTS=3

# ========================================
# Application Configuration
# ========================================
REACT_APP_APP_NAME=Nature Harvest Dashboard
REACT_APP_APP_DESCRIPTION=Admin dashboard for Nature Harvest
REACT_APP_APP_VERSION=1.0.0
REACT_APP_APP_URL=https://admin.natureharvest.com

# ========================================
# Authentication Configuration
# ========================================
REACT_APP_AUTH_TOKEN_KEY=authToken
REACT_APP_AUTH_REFRESH_TOKEN_KEY=refreshToken
REACT_APP_AUTH_EXPIRY_KEY=tokenExpiry
REACT_APP_AUTO_LOGOUT_MINUTES=30

# ========================================
# Feature Flags
# ========================================
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_DEBUG_MODE=false
REACT_APP_ENABLE_ERROR_BOUNDARY=true
REACT_APP_ENABLE_LOGGING=true
REACT_APP_ENABLE_NOTIFICATIONS=true

# ========================================
# UI Configuration
# ========================================
REACT_APP_THEME=light
# Options: light, dark, auto
REACT_APP_LANGUAGE=en
# Options: en, es, fr, etc.
REACT_APP_TIMEZONE=UTC
REACT_APP_DATE_FORMAT=MM/DD/YYYY
REACT_APP_TIME_FORMAT=HH:mm:ss

# ========================================
# Pagination Settings
# ========================================
REACT_APP_DEFAULT_PAGE_SIZE=10
REACT_APP_MAX_PAGE_SIZE=100
REACT_APP_PAGE_SIZE_OPTIONS=10,25,50,100

# ========================================
# File Upload Configuration
# ========================================
REACT_APP_MAX_FILE_SIZE=5242880
# 5MB in bytes
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp
REACT_APP_UPLOAD_ENDPOINT=/api/upload

# ========================================
# Image Configuration
# ========================================
REACT_APP_IMAGE_QUALITY=85
REACT_APP_IMAGE_MAX_WIDTH=1920
REACT_APP_IMAGE_MAX_HEIGHT=1080
REACT_APP_DEFAULT_IMAGE=/images/placeholder.png

# ========================================
# Notification Configuration
# ========================================
REACT_APP_NOTIFICATION_DURATION=5000
REACT_APP_MAX_NOTIFICATIONS=5
REACT_APP_ENABLE_SOUND_NOTIFICATIONS=false

# ========================================
# Development Settings
# ========================================
REACT_APP_DEBUG_MODE=false
REACT_APP_SHOW_API_ERRORS=false
REACT_APP_ENABLE_HOT_RELOAD=false
REACT_APP_LOG_LEVEL=error
# Options: error, warn, info, debug

# ========================================
# Analytics Configuration (Optional)
# ========================================
REACT_APP_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
REACT_APP_MIXPANEL_TOKEN=MIXPANEL_TOKEN
REACT_APP_AMPLITUDE_API_KEY=AMPLITUDE_API_KEY

# ========================================
# Error Tracking (Optional)
# ========================================
REACT_APP_SENTRY_DSN=SENTRY_DSN
REACT_APP_BUGSNAG_API_KEY=BUGSNAG_API_KEY

# ========================================
# External Services (Optional)
# ========================================
REACT_APP_STRIPE_PUBLIC_KEY=STRIPE_PUBLIC_KEY
REACT_APP_GOOGLE_MAPS_API_KEY=GOOGLE_MAPS_API_KEY
REACT_APP_RECAPTCHA_SITE_KEY=RECAPTCHA_SITE_KEY

# ========================================
# Development Environment Example
# ========================================
# REACT_APP_API_URL=http://localhost:3002/api
# REACT_APP_APP_URL=http://localhost:3001
# REACT_APP_ENABLE_ANALYTICS=false
# REACT_APP_DEBUG_MODE=true
# REACT_APP_SHOW_API_ERRORS=true
# REACT_APP_LOG_LEVEL=debug 