# ========================================
# Nature Harvest Server Environment Configuration
# ========================================

# ========================================
# Database Configuration
# ========================================
MONGODB_URI=mongodb://localhost:27017/nature-harvest
# For production: mongodb+srv://username:password@cluster.mongodb.net/nature-harvest

# ========================================
# Server Configuration
# ========================================
PORT=3002
NODE_ENV=production
# Options: development, production, test

# ========================================
# JWT Configuration
# ========================================
JWT_SECRET=your-super-secure-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h
# Options: 1h, 24h, 7d, 30d

# ========================================
# CORS Configuration
# ========================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://natureharvest.com,https://admin.natureharvest.com,https://nature-harvest-q2ra.vercel.app,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# ========================================
# File Upload Configuration
# ========================================
MAX_FILE_SIZE=5242880
# 5MB in bytes (5 * 1024 * 1024)
UPLOAD_PATH=uploads

# ========================================
# Email Configuration (Optional)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@natureharvest.com

# ========================================
# Cloud Storage Configuration (Optional)
# ========================================
# For production file uploads
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=nature-harvest-uploads

# ========================================
# Logging Configuration
# ========================================
LOG_LEVEL=info
# Options: error, warn, info, debug
LOG_FILE=logs/app.log

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# Security Configuration
# ========================================
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-key
COOKIE_SECRET=your-cookie-secret-key

# ========================================
# API Configuration
# ========================================
API_VERSION=v1
API_PREFIX=/api
SWAGGER_ENABLED=false

# ========================================
# Production Settings
# ========================================
DEBUG_MODE=false
SHOW_ERROR_DETAILS=false
ENABLE_SWAGGER=false

# ========================================
# Development Environment Example
# ========================================
# NODE_ENV=development
# MONGODB_URI=mongodb://localhost:27017/nature-harvest
# JWT_SECRET=your-development-secret-key
# DEBUG_MODE=true
# SHOW_ERROR_DETAILS=true
# ENABLE_SWAGGER=true
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003 